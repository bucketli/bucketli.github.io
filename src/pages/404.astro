---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="The page you requested does not exist.">
  <section class="not-found">
    <p class="error-code">404</p>
    <h1>Page not found</h1>
    <p>The address may be outdated, or the page may have been removed.</p>
    <a href="/">Back to home</a>
  </section>
</BaseLayout>
