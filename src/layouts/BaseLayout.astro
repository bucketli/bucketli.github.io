---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "John Li's Blog",
  description = 'Notes on software, systems, and the work around them.',
} = Astro.props;
const pageTitle = title === "John Li's Blog" ? title : `${title} · John Li's Blog`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" type="application/rss+xml" title="John Li's Blog" href={new URL('rss.xml', Astro.site)} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header">
        <a class="site-name" href="/">John Li's Blog</a>
        <a class="rss-link" href="/rss.xml">RSS</a>
      </header>
      <main>
        <slot />
      </main>
      <footer class="site-footer">
        <span>© {new Date().getFullYear()} John Li</span>
      </footer>
    </div>
    <script
      is:inline
      data-goatcounter="https://bucketli.goatcounter.com/count"
      async
      src="https://gc.zgo.at/count.js"
    ></script>
  </body>
</html>
